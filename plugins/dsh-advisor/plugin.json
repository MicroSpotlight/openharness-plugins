{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "dsh-advisor",
  "displayName": "DSH Advisor",
  "summary": "dsh plugin bundle porting the omp advisor subsystem: a per-session reviewer model that observes the primary transcript and injects severity-ranked advice (nit/concern/blocker).",
  "description": "dsh plugin bundle porting the omp advisor subsystem: a per-session reviewer model that observes the primary transcript and injects severity-ranked advice (nit/concern/blocker).",
  "version": "0.2.2",
  "publisher": {
    "name": "omdsh-dev",
    "url": "https://github.com/omdsh-dev"
  },
  "authors": [
    {
      "name": "omdsh-dev",
      "url": "https://github.com/omdsh-dev"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsh-dev/dsh-advisor",
    "issues": "https://github.com/omdsh-dev/dsh-advisor/issues"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-advisor#readme",
  "license": "MIT",
  "distribution": {
    "type": "npm",
    "package": "dsh-advisor"
  },
  "compatibility": {
    "dsh": "0.1.0-rc.6",
    "profiles": [
      "web"
    ],
    "platforms": [
      "web",
      "node",
      "macos",
      "windows",
      "linux"
    ]
  },
  "capabilities": [
    "ui-extension"
  ],
  "categories": [
    "ai",
    "productivity"
  ],
  "keywords": [
    "dsh",
    "advisor"
  ],
  "permissions": {
    "network": [
      "https://*"
    ],
    "filesystemRead": [
      "workspace",
      "~/.dsh"
    ],
    "filesystemWrite": [
      "~/.dsh"
    ],
    "environment": [],
    "commands": []
  }
}
