{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "dsh-gomoku",
  "displayName": "DSH Gomoku",
  "summary": "Gomoku (five-in-a-row) for the dsh web GUI: AI move routes, model catalog, and default prompt (node half) plus the conversation-view tab with the board (browser half)",
  "description": "Gomoku (five-in-a-row) for the dsh web GUI: AI move routes, model catalog, and default prompt (node half) plus the conversation-view tab with the board (browser half)",
  "version": "0.0.1",
  "publisher": {
    "name": "omdsh-dev",
    "url": "https://github.com/omdsh-dev"
  },
  "authors": [
    {
      "name": "omdsh-dev",
      "url": "https://github.com/omdsh-dev"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsh-dev/dsh-gomoku",
    "issues": "https://github.com/omdsh-dev/dsh-gomoku/issues"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-gomoku#readme",
  "license": "MIT",
  "distribution": {
    "type": "npm",
    "package": "@yejiming/dsh-gomoku"
  },
  "compatibility": {
    "dsh": "0.1.0-rc.6",
    "profiles": [
      "web"
    ],
    "platforms": [
      "web",
      "node",
      "macos",
      "windows",
      "linux"
    ]
  },
  "capabilities": [
    "ui-extension"
  ],
  "categories": [
    "search",
    "ai",
    "web"
  ],
  "keywords": [
    "dsh",
    "gomoku"
  ],
  "permissions": {
    "network": [
      "https://*"
    ],
    "filesystemRead": [],
    "filesystemWrite": [],
    "environment": [],
    "commands": []
  }
}
