{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "dsh-client-ui-task-board",
  "displayName": "DSH Client UI Task Board",
  "summary": "Task board for the dsh web GUI: a sidebar entry plus a multi-column kanban view with local persistence, task details, and real execution through dsh sessions (session.prompt). Hot-pluggable — mount...",
  "description": "Task board for the dsh web GUI: a sidebar entry plus a multi-column kanban view with local persistence, task details, and real execution through dsh sessions (session.prompt). Hot-pluggable — mounted via ~/.dsh/cordis.patch.yml + a profile node_modules symlink, no dsh source changes.",
  "version": "0.2.7",
  "publisher": {
    "name": "CAPTAIN1275",
    "url": "https://github.com/CAPTAIN1275"
  },
  "authors": [
    {
      "name": "CAPTAIN1275",
      "url": "https://github.com/CAPTAIN1275"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CAPTAIN1275/dsh-ui-web",
    "issues": "https://github.com/CAPTAIN1275/dsh-ui-web/issues"
  },
  "homepage": "https://github.com/CAPTAIN1275/dsh-ui-web#readme",
  "license": "Apache-2.0",
  "distribution": {
    "type": "npm",
    "package": "@captain1275/dsh-client-ui-task-board"
  },
  "compatibility": {
    "dsh": "0.1.0-rc.6",
    "profiles": [
      "web"
    ],
    "platforms": [
      "web",
      "node",
      "macos",
      "windows",
      "linux"
    ]
  },
  "capabilities": [
    "ui-extension",
    "workflow"
  ],
  "categories": [
    "automation",
    "web"
  ],
  "keywords": [
    "dsh",
    "client",
    "ui",
    "task",
    "board"
  ],
  "permissions": {
    "network": [],
    "filesystemRead": [
      "workspace",
