{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "dsh-client-auto-continue",
  "displayName": "DSH Client Auto Continue",
  "summary": "DSH Web UI plugin: automatically sends \"继续\" (continue) when a request is interrupted by network errors or other non-human causes",
  "description": "DSH Web UI plugin: automatically sends \"继续\" (continue) when a request is interrupted by network errors or other non-human causes",
  "version": "0.6.1",
  "publisher": {
    "name": "HsiangNianian",
    "url": "https://github.com/HsiangNianian"
  },
  "authors": [
    {
      "name": "HsiangNianian",
      "url": "https://github.com/HsiangNianian"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HsiangNianian/dsh-auto-continue",
    "issues": "https://github.com/HsiangNianian/dsh-auto-continue/issues"
  },
  "homepage": "https://github.com/HsiangNianian/dsh-auto-continue#readme",
  "license": "MIT",
  "distribution": {
    "type": "npm",
    "package": "dsh-client-auto-continue"
  },
  "compatibility": {
    "dsh": "0.1.0-rc.6",
    "profiles": [
      "web"
    ],
    "platforms": [
      "web",
      "node",
      "macos",
      "windows",
      "linux"
    ]
  },
  "capabilities": [
    "ui-extension"
  ],
  "categories": [
    "web",
    "productivity"
  ],
  "keywords": [
    "dsh",
    "client",
    "auto",
    "continue"
  ],
  "permissions": {
    "network": [
      "https://*"
    ],
    "filesystemRead": [
      "~/.dsh"
    ],
    "filesystemWrite": [
      "~/.dsh"
    ],
    "environment": [],
    "commands": []
  }
}
