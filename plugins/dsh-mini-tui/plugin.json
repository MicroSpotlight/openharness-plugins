{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "dsh-mini-tui",
  "displayName": "DSH Mini TUI",
  "summary": "DSH Mini TUI: a minimalist terminal interface plugin for DeepSeek Harness",
  "description": "DSH Mini TUI: a minimalist terminal interface plugin for DeepSeek Harness",
  "version": "0.2.1",
  "publisher": {
    "name": "boxeryao",
    "url": "https://github.com/boxeryao"
  },
  "authors": [
    {
      "name": "boxeryao",
      "url": "https://github.com/boxeryao"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/boxeryao/dsh-mini-tui",
    "issues": "https://github.com/boxeryao/dsh-mini-tui/issues"
  },
  "homepage": "https://github.com/boxeryao/dsh-mini-tui#readme",
  "license": "MIT",
  "distribution": {
