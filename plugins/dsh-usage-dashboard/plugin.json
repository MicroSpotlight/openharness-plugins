{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "dsh-usage-dashboard",
  "displayName": "DSH Usage Dashboard",
  "summary": "Usage dashboard for DSH web: colorful per-session / per-day / per-model token usage charts and history (local persistence via ~/.dsh/usage.json).",
  "description": "Usage dashboard for DSH web: colorful per-session / per-day / per-model token usage charts and history (local persistence via ~/.dsh/usage.json).",
  "version": "0.2.7",
  "publisher": {
    "name": "CAPTAIN1275",
    "url": "https://github.com/CAPTAIN1275"
  },
  "authors": [
    {
      "name": "CAPTAIN1275",
      "url": "https://github.com/CAPTAIN1275"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CAPTAIN1275/dsh-ui-web",
    "issues": "https://github.com/CAPTAIN1275/dsh-ui-web/issues"
  },
  "homepage": "https://github.com/CAPTAIN1275/dsh-ui-web#readme",
  "license": "Apache-2.0",
  "distribution": {
    "type": "npm",
    "package": "@captain1275/dsh-usage-dashboard"
  },
  "compatibility": {
