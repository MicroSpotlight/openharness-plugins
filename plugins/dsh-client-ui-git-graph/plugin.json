{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "dsh-client-ui-git-graph",
  "displayName": "DSH Client UI Git Graph",
  "summary": "External dsh web GUI plugin: a git branch selector + Git graph in the conversation header's context hole (beside the official workspace selector), with real host-side git operations (switch/create)...",
  "description": "External dsh web GUI plugin: a git branch selector + Git graph in the conversation header's context hole (beside the official workspace selector), with real host-side git operations (switch/create) and guards, as a dsh profile bundle",
  "version": "0.2.7",
  "publisher": {
    "name": "CAPTAIN1275",
    "url": "https://github.com/CAPTAIN1275"
  },
  "authors": [
    {
      "name": "CAPTAIN1275",
      "url": "https://github.com/CAPTAIN1275"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CAPTAIN1275/dsh-ui-web",
    "issues": "https://github.com/CAPTAIN1275/dsh-ui-web/issues"
  },
  "homepage": "https://github.com/CAPTAIN1275/dsh-ui-web#readme",
  "license": "Apache-2.0",
  "distribution": {
    "type": "npm",
    "package": "@captain1275/dsh-client-ui-git-graph"
  },
  "compatibility": {
    "dsh": "0.1.0-rc.6",
    "profiles": [
      "web"
    ],
    "platforms": [
      "web",
      "node",
      "macos",
      "windows",
      "linux"
    ]
  },
  "capabilities": [
    "ui-extension"
  ],
  "categories": [
    "files",
    "web"
  ],
  "keywords": [
    "dsh",
    "client",
    "ui",
    "git",
    "graph"
  ],
  "permissions": {
    "network": [],
    "filesystemRead": [
      "workspace",
      "~/.dsh"
    ],
    "filesystemWrite": [
      "workspace",
      "~/.dsh"
    ],
    "environment": [],
    "commands": [
      "git"
    ]
  }
}
