{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "dsh-remote",
  "displayName": "DSH Remote",
  "summary": "Remote-work assistant for DeepSeek Harness: connect SSH (password or key), pick a remote workspace, operate on it with rw_pick_workspace / rw_list_dir / rw_read_file / rw_exec / rw_sync tools, and ...",
  "description": "Remote-work assistant for DeepSeek Harness: connect SSH (password or key), pick a remote workspace, operate on it with rw_pick_workspace / rw_list_dir / rw_read_file / rw_exec / rw_sync tools, and mirror it to a real local directory (SFTP) so the DSH native workspace can adopt it.",
  "version": "0.5.7",
  "publisher": {
    "name": "flymysql",
    "url": "https://github.com/flymysql"
  },
  "authors": [
    {
      "name": "flymysql",
      "url": "https://github.com/flymysql"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/flymysql/dsh-remote",
    "issues": "https://github.com/flymysql/dsh-remote/issues"
  },
  "homepage": "https://github.com/flymysql/dsh-remote#readme",
  "license": "MIT",
  "distribution": {
    "type": "npm",
    "package": "dsh-remote"
  },
  "compatibility": {
    "dsh": "0.1.0-rc.6",
    "profiles": [
      "web"
    ],
    "platforms": [
      "web",
      "node",
      "macos",
      "windows",
      "linux"
    ]
  },
  "capabilities": [
    "ui-extension"
  ],
  "categories": [
    "security",
    "files"
  ],
  "keywords": [
    "dsh",
    "remote"
  ],
  "permissions": {
    "network": [
      "https://*"
    ],
    "filesystemRead": [
      "workspace"
    ],
    "filesystemWrite": [
      "workspace"
    ],
    "environment": [],
    "commands": [
      "ssh"
    ]
  }
}
