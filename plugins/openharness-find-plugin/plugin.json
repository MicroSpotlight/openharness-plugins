{
  "$schema": "https://microspotlight.github.io/openharness-plugins/schemas/plugin-v1.schema.json",
  "schemaVersion": 1,
  "name": "openharness-find-plugin",
  "displayName": "OpenHarness Find Plugin",
  "summary": "Discover curated DSH plugins from the OpenHarness catalog.",
  "description": "Adds a searchable Discover tab to the DSH plugin settings and a read-only discovery tool for agents. Discovery never installs code; installation remains an explicit user action delegated to the OpenHarness host.",
  "version": "0.1.0",
  "publisher": {
    "name": "MicroSpotlight",
    "url": "https://github.com/MicroSpotlight"
  },
  "authors": [
    {
      "name": "MicroSpotlight",
      "url": "https://github.com/MicroSpotlight"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MicroSpotlight/openharness-find-plugin",
    "issues": "https://github.com/MicroSpotlight/openharness-find-plugin/issues"
  },
  "homepage": "https://github.com/MicroSpotlight/openharness-find-plugin#readme",
  "license": "Apache-2.0",
  "distribution": {
    "type": "git",
    "package": "@microspotlight/openharness-find-plugin",
    "url": "https://github.com/MicroSpotlight/openharness-find-plugin.git",
    "ref": "8797131113d5595e2898db75b5a137413822c985"
  },
  "compatibility": {
    "dsh": "0.1.0-rc.6",
    "openharness": ">=0.1.0",
    "profiles": ["web"],
    "platforms": ["web", "node", "macos", "windows", "linux"]
  },
  "capabilities": ["tool-provider", "ui-extension"],
  "categories": ["developer-tools", "search"],
  "keywords": ["catalog", "discovery", "dsh", "openharness", "plugins"],
  "permissions": {
    "network": ["https://microspotlight.github.io"],
    "filesystemRead": [],
    "filesystemWrite": [],
    "environment": [],
    "commands": []
  },
  "localizations": {
    "zh-CN": {
      "displayName": "OpenHarness 插件发现",
      "summary": "从 OpenHarness 目录中查找经过收录的 DSH 插件。",
      "description": "在 DSH 插件设置中加入可搜索的发现页面，并为智能体提供只读的插件发现工具。发现过程不会安装代码；安装必须由用户明确触发，并交由 OpenHarness 宿主执行。"
    }
  }
}
